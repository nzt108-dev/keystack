{
  "name": "keystack",
  "version": "0.3.0",
  "description": "Live project registry for coding agents — projects, skills & prompts over MCP",
  "type": "module",
  "bin": {
    "keystack-mcp": "dist/mcp/server.js",
    "keystack": "dist/dashboard/server.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "mcp": "tsx src/mcp/server.ts",
    "dashboard": "tsx src/dashboard/server.ts",
    "dev": "tsx watch src/dashboard/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "mcp",
    "claude-code",
    "codex",
    "vibe-coding",
    "project-registry",
    "agent-memory"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "better-sqlite3": "^11.0.0",
    "fastify": "^5.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.8"
  }
}
